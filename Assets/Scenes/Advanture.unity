MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 933301096}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cda1b141ea53483448890c43b085f612, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textDisplay: {fileID: 273846857}
  sentences:
  - Hello, adventurer!
  - I'm mage Dee and I'm glad that you are here, because we need your help, adventurer!
  - 'Some strange creatures emerged in our world. We don''t know why and frome where.
    We fought them. but we lost the battle because there is too many of them. '
  - We had to retreat and we fled to the safe place. At the end of our world there
    is "he". We call him the "Green One" and he is very powerfull. He is trapped
    at the end of our world in our tample, because we destroyed the last platform.
  - But still we can not live in peace, because he constantly create new creatures.
    If you clear the way to the end by killing some of the creatures, than I could
    create small platform where you can reach him and fight him. You are our last
    hope, adventurer!
  - '-'
  typingSpeed: 0.01
  activateDialog: {fileID: 1799783969}
  moveSpeed: {fileID: 1897550368}
  dashMove: {fileID: 1897550389}
  continueButton: {fileID: 953959466}
  activateQuestUI: {fileID: 185192681483483254}
