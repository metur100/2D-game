  m_Script: {fileID: 11500000, guid: d3518a8aef9bb6d4a86d9380035eb01b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  txt: {fileID: 1348520038}
  TipList:
  - 'Tip: Gether stars or coins to increase your expiriance.'
  - 'Tip: Press W to jump.'
  - 'Tip: By killing enemie it drops you an item. Collect it and use it.'
  - 'Tip: Toggle on and off your backpack.'
  - 'Tip: If you go out of range of enemy, than it wil heal itself to 100 %.'
  - 'Tip: You can drop items by clicking on cross.'
  - 'Tip: If you fall of the platform, then you die.'
  - 'Tip: You should listen the dialogs, so you can know what you should do.'
  - 'Tip: Destroy the surprise box with meele attack or with fireball.'
  - 'Tip: If you shoot in out range of enemie, than you can not kill it.'
  - 'Tip: By completing quest you gain a lot of expiriance and one item.'
  - 'Tip: Reaching a level increase will increase your maximum health and your damage
    done.'
  - 'Tip: Best way to kill a Bee is with fireballs.'
  - 'Tip: You can not kill a Snail while it is inside the shell.'
  - 'Tip: Checkpoints are marked with a "go right" sign.'
