  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3bd06ab539d635c4fba620dead4cf136, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textDisplay: {fileID: 264006099}
  sentences:
  - Hallo advanturer!
  - Thank god that you are here!I I need your help!
  - My 2 borthers are stuck at the end of caves! They can't go out because "he" made
    the walls that blocks the exist of the cave.
  - The walls are cursed and the only way to destroy them is with the holy runes.
    Each of the runes can destroy one wall.
  - 'Tree rune destroys the wall for Upper cave.

    Moon rune destroys the wall
    for Lower Cave.

    Fire rune destroys the wall for Middle Cave.'
  - Very important, adventurer! Those walls can be destroyed only if you activate
    runes near those walls!
  - 0
  typingSpeed: 0.02
  activateDialog: {fileID: 501338605}
  moveSpeed: {fileID: 1354870544}
  dashMove: {fileID: 1354870557}
  continueButton: {fileID: 457436448}
  activateQuestUI: {fileID: 648572455}
