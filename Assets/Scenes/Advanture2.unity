  m_Script: {fileID: 11500000, guid: 9f7d9b4c1a55f724cb6b7a2f6f34bfd4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textDisplay: {fileID: 1491326540}
  sentences:
  - You've found me, adventurer!
  - I bearly survived and now I'm stuck here! At the end of Middle cave is "he".
    You have to kill him!
  - I will create a platform that will help you reach the end of the Middle cave!
    Unfortunately I have power only to create this platform!
  - If you already have not been at my brother, Maskman, then you have to go him.
    He will help you create a second platform! Otherwise go direct to the Middle
    cave!
  - Here is the small platform. If you jump on it, it will teleport you at the start
    of Lower cave!
  - From there you can continue your journey! Good luck, adventurer!
  - 
  typingSpeed: 0.01
  activateDialog: {fileID: 1595071252}
  activatePortal: {fileID: 692622900}
  moveSpeed: {fileID: 1354870544}
  dashMove: {fileID: 1354870557}
  continueButton: {fileID: 2027301877}
  activateTriggerCreatePlatform: {fileID: 156658909}
